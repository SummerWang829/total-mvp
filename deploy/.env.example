# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored. Generate secrets on the server, never paste them into chat:
#   openssl rand -hex 32     (SECRET_KEY)      openssl rand -hex 24     (LIVEKIT_API_SECRET)

# ---- host names (both must have an A record pointing at the server) ----
APP_HOST=deepresearch.morningstarsystem.tech
LK_HOST=lk-deepresearch.morningstarsystem.tech

# ---- app ----
SECRET_KEY=
ALLOW_SIGNUP=true            # create the first admin on the website, then set false and `docker compose up -d`
RETENTION_DAYS=180
DPO_EMAIL=summer.wang@topvisiontechnology.com

# ---- LiveKit (key name must stay `totalkey`, it is also written in livekit.yaml) ----
LIVEKIT_API_KEY=totalkey
LIVEKIT_API_SECRET=

# ---- AI services: the server has no local whisper, so transcription is the fixed demo until you choose a cloud ASR ----
ASR_PROVIDER=mock
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
MODERATOR_PROVIDER=openai
MODERATOR_BASE_URL=https://api.deepseek.com
MODERATOR_MODEL=deepseek-flash
MODERATOR_API_KEY=
MODERATOR_VENDOR=DeepSeek
