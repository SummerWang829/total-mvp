DATABASE_URL=sqlite:///./total.db        # use postgresql+psycopg://... in production
SECRET_KEY=dev-only-secret-change-before-going-live-0123456789
ALLOW_SIGNUP=true                        # set false once your org exists
# LiveKit (leave LIVEKIT_URL empty = dev mode, no video; tokens still carry the real grants)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-0000
RETENTION_DAYS=180
MEDIA_DIR=./media
# ---- Transcription / insights / translation. mock = fixed demo content. For REAL results, fill ONE OpenAI-compatible key: ----
ASR_PROVIDER=mock                        # mock | openai   (openai = /audio/transcriptions with whisper-1; ms/ta/zh/en)
LLM_PROVIDER=mock                        # mock | openai   (insights + translation to Chinese)
# LLM_API_KEY=sk-...                     # used for both unless ASR_API_KEY is set
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# AI moderator (text). Empty lines fall back to the LLM_* values above. Switching model = editing these lines only.
# Local Ollama keeps the conversation on this computer. A cloud model sends participants' answers to that company:
# MODERATOR_VENDOR must name it (it is shown in the consent text), otherwise AI-moderated sessions cannot be created.
# MODERATOR_PROVIDER=openai                # mock | openai (any OpenAI-compatible chat API)
# MODERATOR_BASE_URL=http://127.0.0.1:11434/v1
# MODERATOR_MODEL=qwen2.5:7b
# MODERATOR_TIMEOUT_S=60
# MODERATOR_VENDOR=                        # e.g. DeepSeek (cloud only)

# Evaluation (python -m eval.runner). Empty lines fall back to the MODERATOR_* model above.
# Only simulated participants are used, no real people's data. The judge should be a DIFFERENT model from the one tested.
# EVAL_PARTICIPANT_PROVIDER=openai
# EVAL_PARTICIPANT_BASE_URL=https://api.deepseek.com
# EVAL_PARTICIPANT_MODEL=deepseek-flash
# EVAL_JUDGE_PROVIDER=openai
# EVAL_JUDGE_BASE_URL=
# EVAL_JUDGE_MODEL=
# ASR_MODEL=whisper-1                    # must return segment timestamps
# BLOCKED_COUNTRIES=AT,BE,...            # default: EU27 + IS,LI,NO,GB
DPO_EMAIL=summer.wang@topvisiontechnology.com   # shown to participants as the contact for data requests
# Live captions during the interview: Tencent Cloud real-time speech recognition (all three, or captions stay off). Chinese and English only.
# TENCENT_ASR_APPID=
# TENCENT_ASR_SECRET_ID=
# TENCENT_ASR_SECRET_KEY=
# Account emails (invitation / reset links, "forgot password"): any SMTP service. All of the first, MAIL_FROM and PUBLIC_BASE_URL, or the feature stays off.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURITY=starttls            # starttls | ssl | none
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=星桐 <no-reply@morningstarsystem.tech>
# PUBLIC_BASE_URL=https://deepresearch.morningstarsystem.tech
# Health monitor (deploy/monitor.sh, cron every 5 minutes): a chat bot webhook that takes {"text": "..."} (Feishu / WeCom / Slack incoming webhook). Messages only when something changes.
# ALERT_WEBHOOK_URL=
# LOOP_WATCH_S=2                         # diagnostics: log a stack trace whenever the server stalls longer than this, and every request slower than this
# Data hosting: Tencent Cloud, Singapore region (decided 2026-10-10). Run locally first; no brand domain yet.
